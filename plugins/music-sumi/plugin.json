{
  "id": "music-sumi",
  "name": "Samurai Music",
  "version": "0.1.0",
  "author": "xscriptor",
  "description": "Sumi-e ink music widget: open enso cover, brush progress, seal controls and a compact 10-band ink EQ",
  "type": "shell",
  "compat": {
    "host": ">=1.0.0 <2.0.0"
  },
  "api": {
    "requires": [
      "colors",
      "settings",
      "exec",
      "log",
      "paths"
    ]
  },
  "scope": "music-sumi",
  "defaults": "defaults.json",
  "defaultEnabled": true,
  "provides": {
    "widgets": {
      "faces": {
        "music-sumi": {
          "name": "Samurai Music",
          "icon": "墨",
          "defaultWidth": 420,
          "defaultHeight": 220,
          "defaultVariant": "sumi",
          "stretchWidth": true,
          "requiresFilePicker": false,
          "variants": {
            "sumi": {
              "comp": "widgets/MusicSumiFace.qml",
              "icon": "1",
              "label": "Sumi"
            }
          }
        }
      }
    }
  }
}
