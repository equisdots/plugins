import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs.core

// XFetch Themes — browse the xfetch terminal themes (generated by theme-sync per
// palette + any user themes) and set the active one in config.jsonc. Opened with
// `qs_manager.sh toggle xfetch-themes`.
Item {
    id: window
    focus: true

    Scaler { id: sc; currentWidth: Screen.width }
    function s(v) { return sc.s(v); }

    property var themes: []
    property string current: ""

    function refresh() { listProc.running = false; listProc.running = true; curProc.running = false; curProc.running = true; }

    Process {
        id: listProc
        command: ["bash", Quickshell.env("HOME") + "/.config/hypr/plugins/xfetch-themes/scripts/themes.sh", "list"]
        stdout: StdioCollector { onStreamFinished: window.themes = (this.text || "").trim().split("\n").filter(x => x !== "") }
    }
    Process {
        id: curProc
        command: ["bash", Quickshell.env("HOME") + "/.config/hypr/plugins/xfetch-themes/scripts/themes.sh", "current"]
        stdout: StdioCollector { onStreamFinished: window.current = (this.text || "").trim() }
    }
    Process {
        id: setProc
        command: ["bash", Quickshell.env("HOME") + "/.config/hypr/plugins/xfetch-themes/scripts/themes.sh", "set", "default"]
        stdout: StdioCollector { onStreamFinished: window.refresh() }
    }
    function apply(slug) { setProc.command = ["bash", Quickshell.env("HOME") + "/.config/hypr/plugins/xfetch-themes/scripts/themes.sh", "set", slug]; setProc.running = false; setProc.running = true; }

    Component.onCompleted: refresh()

    Rectangle {
        anchors.fill: parent
        radius: Theme.radiusXl
        color: Theme.glassFill
        border.width: 1
        border.color: Theme.outlineVariant

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: s(16)
            spacing: s(10)

            Text { text: "XFetch Themes"; font.family: "Hack Nerd Font"; font.weight: Font.Black; font.pixelSize: s(18); color: Theme.text }
            Text { text: "active: " + window.current; font.family: "Hack Nerd Font"; font.pixelSize: s(11); color: Theme.subtext0 }

            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: grid.implicitHeight
                GridLayout {
                    id: grid
                    width: parent.width
                    columns: 2
                    columnSpacing: s(8); rowSpacing: s(8)
                    Repeater {
                        model: window.themes
                        delegate: Rectangle {
                            required property var modelData
                            readonly property bool on: modelData === window.current
                            Layout.fillWidth: true
                            implicitHeight: s(38)
                            radius: Theme.radiusMd
                            color: on ? Theme.stateLayer(Theme.mauve, 0.16) : (ma.containsMouse ? Theme.surfaceContainer : Theme.surfaceContainerLow)
                            border.width: 1
                            border.color: on ? Theme.mauve : Theme.outlineVariant
                            Text {
                                anchors.left: parent.left; anchors.leftMargin: s(12); anchors.verticalCenter: parent.verticalCenter
                                text: modelData
                                font.family: "Hack Nerd Font"; font.pixelSize: s(12); font.weight: on ? Font.Bold : Font.Normal
                                color: on ? Theme.mauve : Theme.text
                            }
                            MouseArea { id: ma; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: window.apply(modelData) }
                        }
                    }
                }
            }

            RowLayout { Layout.fillWidth: true
                Text { text: window.themes.length + " themes"; font.family: "Hack Nerd Font"; font.pixelSize: s(10); color: Theme.subtext0; Layout.fillWidth: true }
                Rectangle {
                    width: s(28); height: s(28); radius: Theme.radiusMd
                    color: rMa.containsMouse ? Theme.surfaceContainer : "transparent"
                    border.width: 1; border.color: Theme.outlineVariant
                    Text { anchors.centerIn: parent; text: "󰑐"; font.family: "Hack Nerd Font"; font.pixelSize: s(13); color: Theme.text }
                    MouseArea { id: rMa; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: window.refresh() }
                }
            }
        }
    }
}
