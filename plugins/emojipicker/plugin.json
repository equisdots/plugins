{
  "id": "emojipicker",
  "name": "Glyphs",
  "version": "0.1.0",
  "author": "xscriptor",
  "description": "Searchable Unicode glyph picker with clipboard copy",
  "type": "shell",
  "compat": {
    "host": ">=1.0.0 <2.0.0"
  },
  "api": {
    "requires": [
      "colors",
      "settings",
      "exec",
      "paths",
      "log"
    ]
  },
  "scope": "emojipicker",
  "defaults": "defaults.json",
  "defaultEnabled": true,
  "settings": {
    "page": "settings/GlyphsPage.qml",
    "label": "Glyphs"
  },
  "provides": {
    "panels": {
      "emoji": {
        "comp": "ui/GlyphsPicker.qml",
        "w": 680,
        "h": 540,
        "label": "Glyphs"
      }
    }
  }
}
