{
  "id": "mos-dock",
  "name": "mos Dock",
  "version": "0.1.0",
  "author": "xscriptor",
  "description": "A customizable macOS-style bottom dock with editable app launchers, magnification and translucent glass geometry",
  "type": "shell",
  "compat": { "shell": ">=0.1.0" },
  "toggle": "mos-dock.enabled",
  "scope": "mos-dock",
  "defaults": "defaults.json",
  "defaultEnabled": false,
  "settings": { "page": "settings/MosDockPage.qml", "label": "mos Dock", "icon": "" },
  "host": "host/MosDock.qml",
  "api": { "requires": ["colors", "settings", "exec", "paths", "log"] }
}
