{
  "id": "kbdlayout",
  "name": "Keyboard Layout",
  "version": "0.1.0",
  "author": "xscriptor",
  "description": "Active keyboard layout",
  "type": "shell",
  "compat": {
    "host": ">=1.0.0 <2.0.0"
  },
  "api": {
    "requires": [
      "colors",
      "exec",
