{
  "id": "gitbar",
  "name": "Git Bar",
  "version": "0.1.0",
  "author": "xscriptor",
  "description": "Current git branch and dirty-file count for the focused repo",
  "type": "shell",
  "compat": {
    "host": ">=1.0.0 <2.0.0"
  },
  "api": {
    "requires": [
      "colors",
      "exec",
      "log",
      "paths"
    ]
  },
  "scope": "gitbar",
  "defaults": "defaults.json",
  "defaultEnabled": true,
  "settings": {
    "page": "settings/GitbarPage.qml",
    "label": "Git Bar",
    "icon": "\udb80\udea2"
  },
  "provides": {
    "bar": {
      "modules": {
        "gitbar": {
          "comp": "bar/Gitbar.qml",
          "label": "Git Bar",
          "icon": "\udb80\udea2"
        }
      }
    }
  }
}
